{
  "name": "busy-magic",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @busy/magic",
    "storybook": "storybook dev -p 6006",
    "build": "npm run build --workspaces --if-present && storybook build",
    "tokens:write": "node scripts/token-dtcg.mjs --write",
    "mutate": "stryker run",
    "prepare": "husky || echo \"husky is not installed, so git hooks are not set up. Install dev dependencies and run npm run prepare to get them.\"",
    "check": "npm run check:types && npm run check:lint && npm run check:shape && npm run check:tokens && npm run check:docs && npm run check:dead && npm run check:deps && npm run check:tests && npm run check:stories && npm run check:flow && npm run check:visual && npm run check:groups",
    "check:types": "node scripts/check-types.mjs",
    "check:lint": "node scripts/check-lint.mjs",
    "check:shape": "node scripts/check-shape.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "check:stories": "node scripts/check-stories.mjs",
    "check:flow": "node scripts/check-flow.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "visual:accept": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "check:dead": "node scripts/check-dead.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:groups": "node scripts/check-groups.mjs",
    "check:session": "node scripts/check-session.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-themes": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.8",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "node scripts/check-lint.mjs",
      "node scripts/check-types.mjs"
    ],
    "*.css": [
      "node scripts/check-tokens.mjs"
    ]
  }
}
